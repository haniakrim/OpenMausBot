# The mascot body catalogs are generated by devops/scripts/agent-app/gen-mascot-bodies.ts, which
# writes LF. devops/scripts/agent-app/mascot-bodies/generated.test.mjs re-runs the generator and
# compares the result to what is checked in, so if git hands Windows a CRLF
# checkout every line differs and the drift guard fails for a reason that has
# nothing to do with drift. Pin them to LF on every platform.
be/ai/shared/mascot-bodies.ts text eol=lf
# git runs hooks through sh; a CRLF shebang line is "/bin/sh^M: bad interpreter" on every platform.
devops/scripts/agent-app/git-hooks/* text eol=lf
devops/deploy/podman/*.sh text eol=lf
# install.sh is piped to sh on a customer's server, and the AppArmor profile is loaded as it is.
be/ai/connector/**/*.sh text eol=lf
be/ai/connector/profiles/* text eol=lf
# Vendor patch hashes and original notices must survive Windows checkout
# byte-for-byte. Do not let core.autocrlf rewrite these reviewed inputs.
devops/third_party/browser/** text eol=lf
# The live-eval judge prompts are checksummed in their manifest, and the golden
# scenarios are compared byte for byte with what the redactor writes (LF), in
# be/ai/evals/live/live-suite.test.ts and be/ai/evals/golden/golden.test.ts. A CRLF checkout
# on Windows fails both for a reason that has nothing to do with the evals.
be/ai/evals/live/judge/prompts/** text eol=lf
be/ai/evals/golden/**/*.json text eol=lf
# The announcements file and its JSON Schema: devops/scripts/agent-app/check-announcements.mjs compares the committed schema with the one
# it generates (LF), and installs read the file as main serves it. The comparison ignores line endings too; this keeps a
# Windows checkout identical to what installs download.
be/ai/announcements/*.json text eol=lf
# The bundled model catalog is compared byte for byte with what
# devops/scripts/agent-app/build-model-catalog.mjs writes (LF), and its licence text with the
# LICENSE files, in devops/scripts/agent-app/build-model-catalog.test.mjs and by --check.
be/ai/server/model-catalog/models-dev.snapshot.json text eol=lf
devops/third_party/models-dev/LICENSE text eol=lf
devops/third_party/opencode/LICENSE text eol=lf
# devops/scripts/agent-app/docker-image.test.ts and be/ai/server/cloud-home.test.ts read the
# Dockerfile's instructions line by line, joining a line that ends in "\" to
# the next. A CRLF checkout on Windows ends those lines in "\r", so nothing
# joins and every layering, healthcheck and trust check fails for a reason
# that has nothing to do with the image. Docker itself reads LF everywhere.
Dockerfile text eol=lf
# be/ai/shared/app-frame/host-page.test.ts compares the committed app host page with
# what devops/scripts/agent-app/build-app-host.ts writes (LF), and checks the sha256 on its first
# line against the body after it; the phone apps copy it byte for byte. A CRLF
# checkout on Windows fails both for a reason that has nothing to do with the page.
be/ai/shared/app-frame/app-host.html text eol=lf

# Imported by a vitest test: a CRLF checkout of its first lines broke the import on Windows.
devops/scripts/agent-app/tighten-ratchets.mjs text eol=lf

# The E2E wire vectors are pinned by SHA-256 and compared byte for byte with what be/ai/companion/src/e2e/gen-vectors.ts
# writes (LF), in be/ai/companion/test/e2e/vectors.test.ts; the relay and the phone apps keep pinned copies. A CRLF checkout
# on Windows fails every one of those checks for a reason that has nothing to do with the wire.
be/ai/companion/src/e2e/vectors/** text eol=lf
be/ai/relay/test/vectors/** text eol=lf

# be/ai/server/cloud-home.test.ts matches the edge's Caddy configs line by line with "\n", and Caddy reads them as written;
# a CRLF checkout on Windows fails every match for a reason that has nothing to do with the edge.
devops/deploy/fly/Caddyfile* text eol=lf
devops/deploy/fly/*.caddy text eol=lf

# Bundled skills ship to Linux Clouds as they are, and be/ai/server/skill-publish-to-netlify.test.ts imports a skill's helper
# through vitest: Vite's transform (vitest 4.1.11) fails with "Invalid or unexpected token" on a file that starts
# with a shebang and has CRLF line endings, which is what a Windows checkout made of it.
be/ai/skills/** text eol=lf
